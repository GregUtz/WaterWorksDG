<div class="page-content">
  <main class="content leaderboard-content">
    <section class="leaderboard-hero" aria-labelledby="leaderboard-title">
      <div>
        <span class="leaderboard-eyebrow">WaterWorks Thursdays</span>
        <h1 id="leaderboard-title">2026 Leaderboard</h1>
      </div>
      <div class="leaderboard-source">
        <a href="https://docs.google.com/spreadsheets/d/1oCMTdCbgs93lBp6-4-KCucyrlVXxTCQIg5Da-u1cg9s/edit?usp=sharing" target="_blank" rel="noopener" class="button button-s button-dark"><i class="fa fa-table"></i> Open Master Sheet</a>
      </div>
    </section>

    <section class="leaderboard-stats" aria-label="Season summary" data-season-stats></section>

    <section class="leaderboard-panel" aria-labelledby="standings-title">
      <div class="leaderboard-section-heading standings-heading">
        <div>
          <span class="leaderboard-eyebrow">2026</span>
          <h2 id="standings-title">Player standings</h2>
        </div>
        <p data-results-summary aria-live="polite"></p>
      </div>

      <button type="button" class="leaderboard-filter-toggle" data-leaderboard-filter-toggle aria-expanded="true" aria-controls="leaderboard-controls">
        <span class="leaderboard-filter-toggle-icon"><i class="fa fa-sliders" aria-hidden="true"></i></span>
        <span class="leaderboard-filter-toggle-copy">
          <strong>Leaderboard filters</strong>
          <small data-leaderboard-filter-summary>All players · Championship</small>
        </span>
        <i class="fa fa-chevron-down leaderboard-filter-toggle-chevron" aria-hidden="true"></i>
      </button>

      <form class="leaderboard-controls" id="leaderboard-controls" data-leaderboard-controls>
        <label class="leaderboard-search">
          <span>Find a player</span>
          <span class="leaderboard-input-wrap"><i class="fa fa-search"></i><input type="search" id="player-search" placeholder="Search by name" autocomplete="off"></span>
        </label>
        <label>
          <span>Minimum weeks</span>
          <select id="minimum-rounds">
            <option value="0" selected>All players</option>
            <option value="3">3+ weeks</option>
            <option value="5">5+ weeks</option>
            <option value="10">10+ weeks</option>
          </select>
        </label>
        <label>
          <span>Leaderboard view</span>
          <select id="leaderboard-sort">
            <option value="cut" selected>Championship</option>
            <option value="rounds">Weeks played</option>
            <option value="average">Average score</option>
            <option value="best">Best round</option>
            <option value="name">Player name</option>
          </select>
        </label>
        <button type="reset" class="leaderboard-reset">Reset</button>
      </form>

      <div class="leaderboard-table-wrap">
        <table class="leaderboard-table">
          <thead>
            <tr>
              <th scope="col" class="rank-column">Rank</th>
              <th scope="col" class="player-column">Player</th>
              <th scope="col" class="numeric-column">Weeks</th>
              <th scope="col" class="numeric-column">Average</th>
              <th scope="col" class="numeric-column desktop-score-column">Best</th>
              <th scope="col" class="trend-column">Recent form</th>
              <th scope="col" class="details-column"><span class="screen-reader-text">Details</span></th>
            </tr>
          </thead>
          <tbody data-leaderboard-body>
            <tr><td colspan="7" class="leaderboard-empty">Loading standings…</td></tr>
          </tbody>
        </table>
      </div>
      <noscript><p class="leaderboard-empty">JavaScript is required to sort and explore the leaderboard. The full data remains available in the master sheet.</p></noscript>
    </section>

    <p class="leaderboard-footnote">The default Championship view places players with at least ⅔ of weeks played participation above the qualifying line and ranks them by scoring average. Everyone else follows by weeks played, then average.</p>
